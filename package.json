{
  "name": "dsh-selection-assistant",
  "version": "0.2.2",
  "description": "Global selection assistant for DeepSeek Harness: select text in any Windows or macOS app, hold Ctrl (Control on macOS), and run DeepSeek actions from a floating toolbar.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "selection-assistant",
    "translate",
    "windows",
    "macos",
    "swift",
    "global-hook"
  ],
  "license": "MIT",
  "author": "evanliu3594",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanliu3594/dsh-selection-assistant.git"
  },
  "homepage": "https://github.com/evanliu3594/dsh-selection-assistant#readme",
  "bugs": {
    "url": "https://github.com/evanliu3594/dsh-selection-assistant/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "helper",
    "src",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-host.mjs",
    "verify:client": "node scripts/verify-client-bundle.mjs",
    "verify:helper": "node scripts/verify-helper-resolve.mjs",
    "verify:helper:macos": "node scripts/verify-macos-helper.mjs",
    "verify:host:macos": "node scripts/verify-host-macos.mjs",
    "build:mac-helper": "sh scripts/build-macos-helper.sh",
    "probe": "node scripts/probe.mjs",
    "helper:test": "pwsh -NoProfile -ExecutionPolicy Bypass -File helper/selftest.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
